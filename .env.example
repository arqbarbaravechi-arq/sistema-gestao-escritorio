# Copie este arquivo para .env e preencha os valores reais.
# Nunca commitar o .env preenchido.

# Banco de dados
DATABASE_URL="postgresql://dev:dev@localhost:5432/sistema_gestao_arquitetura"

# Cache / Filas
REDIS_URL="redis://localhost:6379"

# Autenticação (provedor gerenciado — ver Arquitetura Técnica v2.0 §2)
AUTH_SECRET=""
AUTH_PROVIDER_CLIENT_ID=""
AUTH_PROVIDER_CLIENT_SECRET=""

# Armazenamento de arquivos (S3-compatible)
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION=""

# Integração Microsoft Graph (OneDrive) — usado apenas no spike da Sprint 0 (E5)
MS_GRAPH_CLIENT_ID=""
MS_GRAPH_CLIENT_SECRET=""
MS_GRAPH_TENANT_ID=""

# E-mail transacional
EMAIL_PROVIDER_API_KEY=""

# Gestão de chaves de criptografia (KMS) — ver Arquitetura Técnica v2.0 §7/§10
KMS_KEY_ID=""

# Analytics de evento (instrumentação de adoção — E6 da Sprint 0)
ANALYTICS_WRITE_KEY=""

# Ambiente
NODE_ENV="development"
